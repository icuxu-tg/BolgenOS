#!/usr/bin/env bash
set -uo pipefail

LOCAL_HASH_FILE="/etc/bolgenos-release.sha256"
GITHUB_REPO="icuxu-tg/BolgenOS"
RELEASE_PAGE_URL="https://github.com/${GITHUB_REPO}/releases/latest"
REMOTE_HASH_URL="${RELEASE_PAGE_URL}/download/RELEASE_SHA256.txt"
RELEASE_API_URL="https://api.github.com/repos/${GITHUB_REPO}/releases/latest"
REPO_GIT_URL="https://github.com/${GITHUB_REPO}.git"

wait_for_network() {
  local i
  for ((i = 1; i <= 15; i++)); do
    if ip route show default 2>/dev/null | grep -q . && getent hosts github.com >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

launch_terminal_update() {
  local cmd="/usr/local/bin/bolgenos-updater --apply-update"
  if command -v mate-terminal >/dev/null 2>&1; then
    mate-terminal --title="Обновление BolgenOS" -e "$cmd" &
  elif command -v xfce4-terminal >/dev/null 2>&1; then
    xfce4-terminal --title="Обновление BolgenOS" -e "$cmd" &
  elif command -v gnome-terminal >/dev/null 2>&1; then
    gnome-terminal --title="Обновление BolgenOS" -- /usr/local/bin/bolgenos-updater --apply-update &
  elif command -v konsole >/dev/null 2>&1; then
    konsole -e /usr/local/bin/bolgenos-updater --apply-update &
  elif command -v xterm >/dev/null 2>&1; then
    xterm -T "Обновление BolgenOS" -e /usr/local/bin/bolgenos-updater --apply-update &
  else
    zenity --error --title="Обновление BolgenOS"       --text="Не найден терминал (mate-terminal). Выполните вручную: sudo pacman -Syu" 2>/dev/null || true
    return 1
  fi
}

run_interactive_update() {
  local local_hash remote_hash release_json latest_tag published_at cache_dir answer

  echo "============================================"
  echo "       Обновление системы BolgenOS"
  echo "============================================"

  if [[ -r "$LOCAL_HASH_FILE" ]]; then
    local_hash="$(tr -d '[:space:]' < "$LOCAL_HASH_FILE" 2>/dev/null || true)"
    echo "Локальный SHA256 : ${local_hash:-неизвестен}"
  fi

  remote_hash="$(curl -fsSL --max-time 5 "$REMOTE_HASH_URL" 2>/dev/null | tr -d '[:space:]' || true)"
  if [[ -n "$remote_hash" ]]; then
    echo "Удалённый SHA256 : ${remote_hash}"
  fi

  release_json="$(curl -fsSL --max-time 5 "$RELEASE_API_URL" 2>/dev/null || true)"
  if [[ -n "$release_json" ]] && command -v jq >/dev/null 2>&1; then
    latest_tag="$(printf '%s' "$release_json" | jq -r '.tag_name // empty' 2>/dev/null || true)"
    published_at="$(printf '%s' "$release_json" | jq -r '.published_at // empty' 2>/dev/null || true)"
    if [[ -n "$latest_tag" ]]; then
      echo "Последний релиз  : ${latest_tag} (${published_at:-дата неизвестна})"
    fi
  fi

  echo ""
  echo "[1/3] Обновление пакетов системы (sudo pacman -Syu --noconfirm)..."
  if ! sudo pacman -Syu --noconfirm; then
    echo ""
    echo "Ошибка при выполнении pacman -Syu. Проверьте сеть или зеркала (reflector)."
  fi

  echo ""
  echo "[2/3] Проверка и загрузка обновлений конфигураций BolgenOS..."
  cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/bolgenos-repo"
  if command -v git >/dev/null 2>&1; then
    if [[ -d "${cache_dir}/.git" ]]; then
      git -C "$cache_dir" pull --ff-only 2>/dev/null || true
    else
      mkdir -p "$(dirname -- "$cache_dir")"
      git clone --depth 1 "$REPO_GIT_URL" "$cache_dir" 2>/dev/null || true
    fi
    if [[ -d "$cache_dir" ]]; then
      echo "Актуальная копия конфигураций BolgenOS сохранена в: $cache_dir"
    fi
  fi

  echo ""
  echo "[3/3] Полный образ ISO / базовый релиз:"
  read -rp "Открыть страницу последнего релиза на GitHub в браузере? [y/N]: " answer
  case "${answer,,}" in
    y|yes|д|да)
      if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$RELEASE_PAGE_URL" >/dev/null 2>&1 &
      else
        echo "Откройте вручную: $RELEASE_PAGE_URL"
      fi
      ;;
  esac

  echo ""
  read -rp "Готово. Нажмите Enter для закрытия окна..." _
}

main() {
  if [[ "${1:-}" == "--apply-update" ]]; then
    run_interactive_update
    exit 0
  fi

  # Skip silently if local release hash is absent or empty.
  if [[ ! -r "$LOCAL_HASH_FILE" ]]; then
    exit 0
  fi

  local local_hash remote_hash
  local_hash="$(tr -d '[:space:]' < "$LOCAL_HASH_FILE" 2>/dev/null || true)"
  if [[ -z "$local_hash" ]]; then
    exit 0
  fi

  # Poll up to 15 seconds for connectivity without blocking desktop startup.
  if ! wait_for_network; then
    exit 0
  fi

  # Fetch remote release SHA256; exit silently on 404/network errors or non-hash output.
  remote_hash="$(curl -fsSL --max-time 5 "$REMOTE_HASH_URL" 2>/dev/null | tr -d '[:space:]' || true)"
  if [[ ! "$remote_hash" =~ ^[0-9a-fA-F]{64}$ ]]; then
    exit 0
  fi

  if [[ "${local_hash,,}" == "${remote_hash,,}" ]]; then
    exit 0
  fi

  # Require an active graphical session and zenity to prompt the user.
  if [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] || ! command -v zenity >/dev/null 2>&1; then
    exit 0
  fi

  if zenity --question     --title="Обновление BolgenOS"     --text="Доступна новая версия BolgenOS! Локальный SHA256 не совпадает с последним релизом на GitHub. Обновить систему сейчас?"     2>/dev/null; then
    launch_terminal_update
  fi
}

main "$@"
