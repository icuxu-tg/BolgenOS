#!/usr/bin/env bash
set -uo pipefail

LOCAL_HASH_FILE="/etc/bolgenos-release.sha256"
GITHUB_REPO="icuxu-tg/BolgenOS"
RELEASE_PAGE_URL="https://github.com/${GITHUB_REPO}/releases/latest"
REMOTE_HASH_URL="${RELEASE_PAGE_URL}/download/RELEASE_SHA256.txt"
RELEASE_API_URL="https://api.github.com/repos/${GITHUB_REPO}/releases/latest"
REPO_GIT_URL="https://github.com/${GITHUB_REPO}.git"
STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/bolgenos"
STATE_FILE="$STATE_DIR/updater.state"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/bolgenos-repo"

wait_for_network() {
  local i
  for ((i = 1; i <= 15; i++)); do
    if ip route show default 2>/dev/null | grep -q . && getent hosts github.com >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

# --- Состояние пользователя (какую версию уже видел/пропустил) ------------
read_state() {
  local key="$1"
  [[ -r "$STATE_FILE" ]] || return 0
  grep -E "^${key}=" "$STATE_FILE" 2>/dev/null | tail -n1 | cut -d= -f2-
}

write_state() {
  local key="$1" val="${2:-}" tmp
  mkdir -p "$STATE_DIR" 2>/dev/null || return 0
  tmp="$(mktemp "${STATE_FILE}.XXXXXX" 2>/dev/null)" || return 0
  if [[ -r "$STATE_FILE" ]]; then
    grep -vE "^${key}=" "$STATE_FILE" > "$tmp" 2>/dev/null || true
  fi
  printf '%s=%s\n' "$key" "$val" >> "$tmp"
  mv -f "$tmp" "$STATE_FILE" 2>/dev/null || rm -f "$tmp"
}

fetch_latest_tag() {
  local json tag
  json="$(curl -fsSL --max-time 8 "$RELEASE_API_URL" 2>/dev/null || true)"
  [[ -n "$json" ]] || return 1
  if command -v jq >/dev/null 2>&1; then
    tag="$(printf '%s' "$json" | jq -r '.tag_name // empty' 2>/dev/null || true)"
  else
    tag="$(printf '%s' "$json" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
  fi
  [[ -n "$tag" ]] || return 1
  printf '%s\n' "$tag"
}

fetch_hash_for_tag() {
  local tag="${1:-}" url h
  if [[ -n "$tag" ]]; then
    url="https://github.com/${GITHUB_REPO}/releases/download/${tag}/RELEASE_SHA256.txt"
    h="$(curl -fsSL --max-time 8 "$url" 2>/dev/null | tr -d '[:space:]' || true)"
    if [[ "$h" =~ ^[0-9a-fA-F]{64}$ ]]; then
      printf '%s' "$h"
      return 0
    fi
  fi
  curl -fsSL --max-time 8 "$REMOTE_HASH_URL" 2>/dev/null | tr -d '[:space:]' || true
}

launch_terminal_update() {
  local cmd="/usr/local/bin/bolgenos-updater --apply-update"
  if command -v mate-terminal >/dev/null 2>&1; then
    mate-terminal --title="Обновление BolgenOS" -e "$cmd" &
  elif command -v xfce4-terminal >/dev/null 2>&1; then
    xfce4-terminal --title="Обновление BolgenOS" -e "$cmd" &
  elif command -v gnome-terminal >/dev/null 2>&1; then
    gnome-terminal --title="Обновление BolgenOS" -- /usr/local/bin/bolgenos-updater --apply-update &
  elif command -v konsole >/dev/null 2>&1; then
    konsole -e /usr/local/bin/bolgenos-updater --apply-update &
  elif command -v xterm >/dev/null 2>&1; then
    xterm -T "Обновление BolgenOS" -e /usr/local/bin/bolgenos-updater --apply-update &
  else
    zenity --error --title="Обновление BolgenOS" \
      --text="Не найден терминал. Выполните вручную: bolgenos-updater --apply-update" 2>/dev/null || true
    return 1
  fi
}

# Обновление собственных компонентов BolgenOS (не системных /etc-конфигов).
overlay_update() {
  local tag="$1"
  command -v git >/dev/null 2>&1 || { echo "git не установлен — компоненты BolgenOS пропущены."; return 1; }

  if [[ -d "$CACHE_DIR/.git" ]]; then
    git -C "$CACHE_DIR" fetch --depth 1 origin "refs/tags/${tag}" 2>/dev/null || git -C "$CACHE_DIR" pull --ff-only 2>/dev/null || true
    git -C "$CACHE_DIR" checkout -q FETCH_HEAD 2>/dev/null || true
  else
    mkdir -p "$(dirname -- "$CACHE_DIR")"
    git clone --depth 1 --branch "$tag" "$REPO_GIT_URL" "$CACHE_DIR" 2>/dev/null \
      || git clone --depth 1 "$REPO_GIT_URL" "$CACHE_DIR" 2>/dev/null || return 1
  fi

  local src="$CACHE_DIR/airootfs"
  [[ -d "$src" ]] || return 1

  sudo rsync -a "$src/usr/local/bin/" /usr/local/bin/
  sudo rsync -a "$src/usr/local/share/dash-shell/" /usr/local/share/dash-shell/
  sudo rsync -a "$src/usr/share/bolgenos/" /usr/share/bolgenos/
  sudo rsync -a "$src/usr/share/applications/" /usr/share/applications/
  sudo rsync -a "$src/usr/share/icons/hicolor/scalable/apps/" /usr/share/icons/hicolor/scalable/apps/
  sudo rsync -a "$src/etc/fastfetch/" /etc/fastfetch/
  sudo rsync -a "$src/etc/xdg/fastfetch/" /etc/xdg/fastfetch/
  sudo install -Dm644 "$src/etc/dashrc" /etc/dashrc
  sudo gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
  return 0
}

run_interactive_update() {
  local local_hash="" remote_hash="" tag="" ok_overlay=1

  echo "============================================"
  echo "       Обновление системы BolgenOS"
  echo "============================================"

  tag="$(fetch_latest_tag || true)"
  [[ -n "$tag" ]] || tag="$(basename "$RELEASE_PAGE_URL")"
  remote_hash="$(fetch_hash_for_tag "$tag")"

  if [[ -r "$LOCAL_HASH_FILE" ]]; then
    local_hash="$(tr -d '[:space:]' < "$LOCAL_HASH_FILE" 2>/dev/null || true)"
    echo "Установленная версия : ${local_hash:-неизвестна}"
  fi
  [[ -n "$remote_hash" ]] && echo "Доступная версия    : ${remote_hash} (${tag})"

  echo ""
  echo "[1/3] Обновление пакетов ОС (sudo pacman -Syu --noconfirm)..."
  if ! sudo pacman -Syu --noconfirm; then
    echo ""
    echo "Ошибка pacman -Syu. Проверьте сеть/зеркала и повторите."
    echo "Компоненты BolgenOS не будут обновлены."
    read -rp "Нажмите Enter для закрытия..." _ || true
    return 1
  fi

  echo ""
  echo "[2/3] Обновление компонентов BolgenOS из GitHub (${tag})..."
  if overlay_update "$tag"; then
    echo "Компоненты BolgenOS обновлены (приложения, обои, иконки, dash-shell)."
  else
    ok_overlay=0
    echo "Не удалось обновить компоненты BolgenOS — системные пакеты уже обновлены."
  fi

  echo ""
  echo "[3/3] Фиксация версии..."
  if [[ -n "$remote_hash" && "$remote_hash" =~ ^[0-9a-fA-F]{64}$ ]]; then
    printf '%s\n' "$remote_hash" | sudo tee "$LOCAL_HASH_FILE" >/dev/null && \
      echo "Локальная версия обновлена: $remote_hash"
  fi
  write_state applied_tag "$tag"
  write_state skipped_tag "$tag"
  [[ "$ok_overlay" == 1 ]] || write_state last_error "overlay failed for $tag"

  echo ""
  read -rp "Готово. Нажмите Enter для закрытия окна..." _ || true
}

prompt_and_run() {
  local tag="$1" choice
  choice="$(zenity --list --radiolist \
    --title="Обновление BolgenOS" \
    --text="Доступна новая версия BolgenOS: <b>${tag}</b>\n\nОбновить систему сейчас?" \
    --column="Выбор" --column="Действие" \
    TRUE "Обновить сейчас" \
    FALSE "Пропустить эту версию" \
    FALSE "Напомнить позже" \
    --height=280 --width=480 2>/dev/null || true)"
  case "$choice" in
    "Обновить сейчас") launch_terminal_update ;;
    "Пропустить эту версию") write_state skipped_tag "$tag" ;;
    *) : ;;
  esac
}

main() {
  if [[ "${1:-}" == "--apply-update" ]]; then
    run_interactive_update
    return $?
  fi
  if [[ "${1:-}" == "--status" ]]; then
    echo "Локальная версия: $(tr -d '[:space:]' < "$LOCAL_HASH_FILE" 2>/dev/null || echo '—')"
    echo "Последний релиз : $(fetch_latest_tag || echo '—')"
    echo "Пропущена версия: $(read_state skipped_tag || true)"
    return 0
  fi

  [[ -r "$LOCAL_HASH_FILE" ]] || exit 0
  local local_hash tag remote_hash
  local_hash="$(tr -d '[:space:]' < "$LOCAL_HASH_FILE" 2>/dev/null || true)"
  [[ -n "$local_hash" ]] || exit 0

  wait_for_network || exit 0

  tag="$(fetch_latest_tag || true)"
  [[ -n "$tag" ]] || exit 0

  # Не напоминаем про эту же версию повторно.
  [[ "$(read_state applied_tag)" == "$tag" ]] && exit 0
  [[ "$(read_state skipped_tag)" == "$tag" ]] && exit 0

  remote_hash="$(fetch_hash_for_tag "$tag")"
  [[ "$remote_hash" =~ ^[0-9a-fA-F]{64}$ ]] || exit 0
  [[ "${local_hash,,}" == "${remote_hash,,}" ]] && exit 0

  [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] || exit 0
  command -v zenity >/dev/null 2>&1 || exit 0

  prompt_and_run "$tag"
}

main "$@"
