#!/usr/bin/env bash
set -euo pipefail

MIRRORLIST="/etc/pacman.d/mirrorlist"
GNUPG_DIR="/etc/pacman.d/gnupg"

write_fallback_mirrorlist() {
  mkdir -p /etc/pacman.d
  cat > "$MIRRORLIST" <<'MIRRORS'
##
## Arch Linux repository mirrorlist (BolgenOS fallback HTTPS mirrors)
##

Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://fastly.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch
Server = https://mirror.leaseweb.net/archlinux/$repo/os/$arch
Server = https://ftp.halifax.rwth-aachen.de/archlinux/$repo/os/$arch
MIRRORS
  chmod 0644 "$MIRRORLIST"
}

ensure_mirrorlist() {
  if grep -Eq '^[[:space:]]*Server[[:space:]]*=' "$MIRRORLIST" 2>/dev/null; then
    return 0
  fi

  write_fallback_mirrorlist

  # Optionally refresh mirrors via reflector when online without failing offline.
  if command -v reflector >/dev/null 2>&1; then
    local tmp_mirrorlist
    tmp_mirrorlist="$(mktemp /tmp/bolgenos-mirrorlist.XXXXXX)"
    if reflector --latest 10 --protocol https --sort rate \
      --connection-timeout 3 --download-timeout 5 \
      --save "$tmp_mirrorlist" >/dev/null 2>&1 \
      && grep -Eq '^[[:space:]]*Server[[:space:]]*=' "$tmp_mirrorlist"; then
      chmod 0644 "$tmp_mirrorlist"
      mv -f "$tmp_mirrorlist" "$MIRRORLIST"
    else
      rm -f "$tmp_mirrorlist"
    fi
  fi
}

keyring_is_healthy() {
  [[ -d "$GNUPG_DIR" ]] || return 1
  [[ -w "$GNUPG_DIR" ]] || return 1

  if [[ -e "$GNUPG_DIR/pubring.gpg" ]] && [[ ! -w "$GNUPG_DIR/pubring.gpg" ]]; then
    return 1
  fi
  if [[ -e "$GNUPG_DIR/trustdb.gpg" ]] && [[ ! -w "$GNUPG_DIR/trustdb.gpg" ]]; then
    return 1
  fi

  pacman-key --list-sigs >/dev/null 2>&1 || return 1
  pacman-key --list-keys 2>/dev/null | grep -qi 'archlinux' || return 1
}

init_keyring() {
  mkdir -p /etc/pacman.d
  if [[ -e "$GNUPG_DIR" ]]; then
    chmod 0700 "$GNUPG_DIR" 2>/dev/null || true
    chmod -R u+rwX "$GNUPG_DIR" 2>/dev/null || true
  fi

  if pacman-key --init && pacman-key --populate archlinux; then
    return 0
  fi

  # Clean up broken/unwritable keyring and re-initialize from scratch.
  rm -rf "$GNUPG_DIR"
  pacman-key --init
  pacman-key --populate archlinux
}

ensure_keyring() {
  if keyring_is_healthy; then
    return 0
  fi

  if [[ ! -d "$GNUPG_DIR" ]] || [[ ! -w "$GNUPG_DIR" ]]; then
    rm -rf "$GNUPG_DIR"
  fi

  init_keyring
}

ensure_mirrorlist
ensure_keyring
