#!/usr/bin/env bash
set -euo pipefail

DE="${1:-mate}"
if [[ "$DE" == "mate" ]]; then
  exit 0
fi

# Ensure pacman keyring is initialized inside target chroot.
if ! pacman-key --list-sigs >/dev/null 2>&1; then
  pacman-key --init
  pacman-key --populate archlinux
fi

# Ensure active Arch mirrors exist.
if ! grep -q '^Server\s*=' /etc/pacman.d/mirrorlist 2>/dev/null; then
  if command -v reflector >/dev/null 2>&1; then
    reflector --latest 10 --protocol https --sort rate --save /etc/pacman.d/mirrorlist || true
  fi
fi
if ! grep -q '^Server\s*=' /etc/pacman.d/mirrorlist 2>/dev/null; then
  printf 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch\n' > /etc/pacman.d/mirrorlist
fi

case "$DE" in
  kde)
    pacman -Syu --noconfirm --needed plasma-meta konsole dolphin ark sddm
    systemctl disable lightdm.service 2>/dev/null || true
    systemctl enable -f sddm.service
    ;;
  xfce)
    pacman -Syu --noconfirm --needed xfce4 xfce4-goodies
    sed -i 's/^user-session=.*/user-session=xfce/' /etc/lightdm/lightdm.conf.d/10-bolgenos.conf
    ;;
  cinnamon)
    pacman -Syu --noconfirm --needed cinnamon nemo-fileroller
    sed -i 's/^user-session=.*/user-session=cinnamon/' /etc/lightdm/lightdm.conf.d/10-bolgenos.conf
    ;;
  gnome)
    pacman -Syu --noconfirm --needed gnome gnome-tweaks gdm
    systemctl disable lightdm.service 2>/dev/null || true
    systemctl enable -f gdm.service
    ;;
  *)
    echo "Unknown DE: $DE" >&2
    exit 1
    ;;
esac
