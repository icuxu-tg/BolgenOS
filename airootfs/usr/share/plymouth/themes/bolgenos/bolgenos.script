Window.SetBackgroundTopColor(0.043, 0.063, 0.125);
Window.SetBackgroundBottomColor(0.102, 0.165, 0.290);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 20);
logo.sprite.SetZ(10);

progress_box.image = Image.Text("BolgenOS", 0.96, 0.97, 1.0, 1.0, "DejaVu Sans Bold 18");
progress_box.sprite = Sprite(progress_box.image);
progress_box.sprite.SetX(Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2);
progress_box.sprite.SetY(Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 8);
progress_box.sprite.SetZ(10);

tick = 0;
fun refresh_callback() {
  tick++;
  pulse = 0.78 + 0.22 * Math.Sin(tick / 18.0);
  logo.sprite.SetOpacity(pulse);
}
Plymouth.SetRefreshFunction(refresh_callback);

message_sprite = Sprite();
message_sprite.SetPosition(10, 10, 10000);
fun message_callback(text) {
  my_image = Image.Text(text, 0.8, 0.9, 1.0, 1.0, "DejaVu Sans 11");
  message_sprite.SetImage(my_image);
  message_sprite.SetX(Window.GetWidth() / 2 - my_image.GetWidth() / 2);
  message_sprite.SetY(Window.GetHeight() - 50);
}
Plymouth.SetMessageFunction(message_callback);
